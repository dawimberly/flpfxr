# Copy to .env and fill in real values. Do not commit .env.

VITE_AUTH_ENABLED=true
BETTER_AUTH_URL=http://localhost:8080
BETTER_AUTH_SECRET=generate-a-32-char-or-longer-random-string

# Required on Vercel production (Neon Postgres URL):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

EMPLOYEE_EMAIL=jon@theflipfixer.com
EMPLOYEE_PASSWORD=choose-a-strong-password
EMPLOYEE_NAME=Jon

# Contact lead delivery (server /api/leads → Resend). Required in production for the form.
# Create a free Resend account, verify theflipfixer.com (or use onboarding@resend.dev for tests),
# then set these on Vercel Production. Do not commit real keys.
# RESEND_API_KEY=re_xxxxxxxx
# LEAD_TO_EMAIL=Jon@TheFlipFixer.com
# LEAD_FROM_EMAIL=The Flip Fixer <leads@theflipfixer.com>

# Roof tracer 3D + auto square quote. Enable Maps JavaScript API, 3D Maps, and Solar API.
# VITE_GOOGLE_MAPS_API_KEY=

# Optional client-side Microsoft Clarity project ID (leave unset to disable).
# VITE_CLARITY_PROJECT_ID=
